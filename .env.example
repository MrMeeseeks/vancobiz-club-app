# Copy to .env (never commit .env). Both values are in Supabase → Project Settings → API.
# The anon key is public by design; Row Level Security protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Voice interview prototype (optional) ---
# Secret. Used only by "npm run voice:create-agents" on your machine. Never prefix it with VITE_.
ELEVENLABS_API_KEY=
# Printed by that script. For local testing only: do not add them as repo secrets, so the public
# site does not ship your agent IDs (paste them into the /#/voice-test page instead).
VITE_ELEVENLABS_AGENT_ID_EN=
VITE_ELEVENLABS_AGENT_ID_FA=
